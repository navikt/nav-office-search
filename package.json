{
	"name": "nav-office-search",
	"version": "1.2.6",
	"private": true,
	"type": "module",
	"imports": {
		"#client/*": "./client/*",
		"#dist/*": "./dist/*",
		"#server/*": "./server/*",
		"#shared/*": "./shared/*",
		"#test/*": "./test/*"
	},
	"scripts": {
		"dev": "node --env-file=.env.development --import ./test/mocks/dev.ts node_modules/vite/bin/vite.js",
		"build": "vite build && vite build --ssr server/main.ts",
		"start": "NODE_ENV=production node --env-file=.env.development --import ./test/mocks/dev.ts dist/server/main.js",
		"prod-local": "pnpm build && pnpm start",
		"lint": "eslint . && tsc --noEmit",
		"test": "vitest run",
		"pretest:http": "pnpm run build",
		"test:http": "vitest run --config test/http/vitest.config.ts",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"prepare": "husky || true"
	},
	"dependencies": {
		"@hono/node-server": "2.1.6",
		"@itsy/html": "1.2.0",
		"@navikt/ds-react": "8.21.0",
		"@navikt/nav-dekoratoren-moduler": "4.5.3",
		"@navikt/navno-logger": "1.1.0",
		"@prometheus-io/client": "0.16.1",
		"hono": "4.13.16",
		"html-react-parser": "6.1.9",
		"lodash.debounce": "4.0.8",
		"node-cache": "5.1.2",
		"node-schedule": "2.1.2",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@eslint-react/eslint-plugin": "5.28.8",
		"@eslint/js": "10.0.1",
		"@hono/vite-dev-server": "0.26.1",
		"@navikt/ds-css": "8.21.0",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/jsdom": "30.0.0",
		"@types/lodash.debounce": "4.0.9",
		"@types/node": "26.6.6",
		"@types/node-schedule": "2.1.8",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.2.1",
		"eslint": "10.14.0",
		"husky": "9.1.7",
		"jsdom": "30.1.3",
		"lint-staged": "17.6.0",
		"msw": "3.0.3",
		"oxfmt": "0.75.0",
		"pino-pretty": "13.2.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,md,yml,yaml,css,scss,html}": "oxfmt --no-error-on-unmatched-pattern"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.13.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": "26"
	},
	"packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
