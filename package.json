{
	"name": "nav-office-search",
	"version": "1.2.6",
	"private": true,
	"type": "module",
	"imports": {
		"#client/*": "./client/*",
		"#dist/*": "./dist/*",
		"#server/*": "./server/*",
		"#shared/*": "./shared/*",
		"#test/*": "./test/*"
	},
	"scripts": {
		"dev": "node --env-file=.env.development --import ./test/mocks/dev.ts node_modules/vite/bin/vite.js",
		"build": "vite build && vite build --ssr server/main.ts",
		"start": "NODE_ENV=production node --env-file=.env.development --import ./test/mocks/dev.ts dist/server/main.js",
		"prod-local": "pnpm build && pnpm start",
		"lint": "oxfmt --check && oxlint && tsc --noEmit",
		"test": "vitest run",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"dependencies": {
		"@hono/node-server": "2.1.8",
		"@itsy/corgi": "1.5.0",
		"@itsy/html": "1.2.0",
		"@navikt/ds-react": "8.22.1",
		"@navikt/nav-dekoratoren-moduler": "4.6.0",
		"@navikt/navno-logger": "1.2.0",
		"@navikt/navno-server": "^1.0.0",
		"@prometheus-io/client": "0.16.1",
		"hono": "4.13.18",
		"html-react-parser": "6.1.9",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"ufo": "1.6.4",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@hono/vite-dev-server": "0.26.1",
		"@nais/apm": "0.7.3",
		"@navikt/ds-css": "8.22.1",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.12",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"jsdom": "30.1.3",
		"lefthook": "2.2.2",
		"oxfmt": "0.78.0",
		"oxlint": "1.93.0",
		"oxlint-tsgolint": "7.0.2007",
		"pino-pretty": "13.2.0",
		"typescript": "6.0.3",
		"vite": "8.3.8",
		"vitest": "5.1.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.13.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": "26"
	},
	"packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
