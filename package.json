{
    "name": "nav-office-search",
    "version": "1.2.6",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485",
    "scripts": {
        "build": "tsc --project packages/client/tsconfig.json --noEmit && pnpm --filter nav-office-search-client build:client && pnpm --filter nav-office-search-client build:ssr && pnpm --filter nav-office-search-server build",
        "start": "pnpm --filter nav-office-search-server start",
        "lint": "eslint . && pnpm --filter nav-office-search-client exec tsc --noEmit && pnpm --filter nav-office-search-server exec tsc --noEmit",
        "decorator": "docker compose up",
        "dev": "pnpm --filter nav-office-search-server dev",
        "prod-local": "pnpm --filter nav-office-search-server prod-local",
        "test": "pnpm --filter nav-office-search-client test",
        "prepare": "husky || true"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "5.18.0",
        "@eslint/js": "10.0.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@types/jest": "30.0.0",
        "@types/lodash.debounce": "4.0.9",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "eslint": "10.7.0",
        "husky": "9.1.7",
        "identity-obj-proxy": "3.0.0",
        "jest": "30.4.2",
        "jest-environment-jsdom": "30.4.1",
        "jest-fetch-mock": "4.2.0",
        "lint-staged": "17.2.0",
        "prettier": "3.9.6",
        "ts-jest": "29.4.12",
        "typescript": "6.0.3",
        "typescript-eslint": "8.65.0",
        "vite": "8.1.5"
    },
    "lint-staged": {
        "*.{js,jsx,json,md,ts,tsx,scss,css}": "prettier --write"
    }
}
