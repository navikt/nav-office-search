{
	"name": "nav-office-search",
	"version": "1.2.6",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc --project packages/client/tsconfig.json --noEmit && pnpm --filter nav-office-search-client build:client && pnpm --filter nav-office-search-client build:ssr && pnpm --filter nav-office-search-server build",
		"start": "pnpm --filter nav-office-search-server start",
		"lint": "eslint . && pnpm --filter nav-office-search-client exec tsc --noEmit && pnpm --filter nav-office-search-server exec tsc --noEmit",
		"decorator": "docker compose up",
		"dev": "pnpm --filter nav-office-search-server dev",
		"prod-local": "pnpm --filter nav-office-search-server prod-local",
		"test": "pnpm --filter nav-office-search-client test",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"prepare": "husky || true"
	},
	"devDependencies": {
		"@eslint-react/eslint-plugin": "5.20.8",
		"@eslint/js": "10.0.1",
		"eslint": "10.11.0",
		"husky": "9.1.7",
		"lint-staged": "17.5.1",
		"oxfmt": "0.71.0",
		"typescript": "catalog:",
		"typescript-eslint": "8.70.1"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,md,yml,yaml,css,scss,html}": "oxfmt --no-error-on-unmatched-pattern"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.19.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": "24"
	},
	"packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
