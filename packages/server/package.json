{
	"name": "nav-office-search-server",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"build": "rm -fr dist && tsc",
		"start": "node --env-file-if-exists=.env dist/server/src/server.js",
		"start-local": "pnpm build && concurrently \"tsc -w\" \"nodemon -w dist/server --env-file-if-exists=.env --import=../../test/mocks/dev.ts dist/server/src/server.js\"",
		"prod-local": "cp .env.local-prod .env && pnpm start-local",
		"dev": "cp .env.development .env && pnpm start-local"
	},
	"dependencies": {
		"@hono/node-server": "2.1.6",
		"@navikt/nav-dekoratoren-moduler": "catalog:",
		"@prometheus-io/client": "0.16.1",
		"hono": "4.13.16",
		"node-cache": "5.1.2",
		"node-schedule": "2.1.2",
		"react": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@types/node-schedule": "2.1.8",
		"concurrently": "10.0.6",
		"nodemon": "3.1.14",
		"vite": "catalog:"
	}
}
